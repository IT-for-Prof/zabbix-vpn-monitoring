# Public repository allowlist. Everything else stays local by default.
*
!/.gitignore
!/LICENSE
!/README.md
!/collectors/
!/collectors/**
!/docs/
!/docs/**
!/installers/
!/installers/**
!/lib/
!/lib/**
!/templates/
!/templates/**

# Local artifacts and secrets stay denied inside allowed directories.
*.tmp
*.output
*.log
.DS_Store
*.key
*-private.conf
secrets/
